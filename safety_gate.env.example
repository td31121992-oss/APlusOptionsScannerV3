# Do not put DHAN_CLIENT_ID or DHAN_ACCESS_TOKEN in this example file.
APLUS_SAFETY_ENABLED=true
APLUS_SAFETY_MODE=PAPER_OBSERVE
APLUS_SAFETY_MIN_TRADING_DTE=4
APLUS_SAFETY_INTRADAY_EXIT_TIME=15:15

APLUS_SAFETY_EVENT_LOOKAHEAD_DAYS=2
APLUS_SAFETY_EVENT_LOOKBACK_DAYS=0
APLUS_SAFETY_EVENT_MAX_AGE_DAYS=7
APLUS_SAFETY_BLOCK_EVENT_SEVERITIES=HIGH,CRITICAL

APLUS_SAFETY_MWPL_ELEVATED_PERCENT=60
APLUS_SAFETY_MWPL_BLOCK_PERCENT=80
APLUS_SAFETY_MWPL_BAN_PERCENT=95
APLUS_SAFETY_MWPL_MAX_AGE_DAYS=2

APLUS_SAFETY_ACCOUNT_CAPITAL=500000
APLUS_SAFETY_TRADE_RISK_PERCENT=10.0
APLUS_SAFETY_MAX_DAILY_LOSS_PERCENT=1.50
APLUS_SAFETY_MAX_OPEN_POSITIONS=2
APLUS_SAFETY_MAX_TOTAL_PREMIUM_PERCENT=20
APLUS_SAFETY_MAX_TRADES_PER_DAY=3
APLUS_SAFETY_MAX_CONSECUTIVE_LOSSES=2
APLUS_SAFETY_BALANCE_BUFFER_PERCENT=5
APLUS_SAFETY_PORTFOLIO_STATE_MAX_AGE_DAYS=0

APLUS_COST_BROKERAGE_PER_ORDER=20
APLUS_COST_EXCHANGE_PERCENT=0.003
APLUS_COST_SEBI_PERCENT=0.0001
APLUS_COST_IPFT_OTHER_PERCENT=0
APLUS_COST_GST_PERCENT=18
APLUS_COST_OPTION_STT_SELL_PERCENT=0.15
APLUS_COST_OPTION_STAMP_BUY_PERCENT=0.003
APLUS_COST_EXECUTION_IMPACT_PERCENT_PER_SIDE=0.10
APLUS_SAFETY_MIN_NET_REWARD_COST_MULTIPLE=2.0
APLUS_SAFETY_MIN_NET_REWARD_RISK_RATIO=0.50

# Long-option risk: 10% of the premium/capital committed to each trade.
APLUS_OPTION_STOP_LOSS_PERCENT=10.0
