# Continuous intraday movement engine (no credentials in this example)
INTRADAY_POLL_SECONDS=60
INTRADAY_SESSION_START=09:15
INTRADAY_EARLIEST_SIGNAL=09:20
INTRADAY_CONFIRMATION_TIME=09:30
INTRADAY_OPENING_PHASE_END=10:30
INTRADAY_MORNING_END=12:00
INTRADAY_MIDDAY_END=13:30
INTRADAY_SESSION_STOP=15:30

# Legacy compatibility only. These no longer block PAPER trade generation.
INTRADAY_NORMAL_ENTRY_CUTOFF=14:45
INTRADAY_LATEST_ENTRY=15:05
INTRADAY_LATE_A_PLUS_SCORE=90

INTRADAY_QUOTE_SHORTLIST=50
INTRADAY_CANDLE_SHORTLIST=30
INTRADAY_MAX_OPTION_CANDIDATES=5
INTRADAY_MAX_REPORT_CANDIDATES=30
INTRADAY_HISTORICAL_WORKERS=4
INTRADAY_HISTORY_DAYS=8
INTRADAY_QUOTE_TAPE_MINUTES=65
INTRADAY_PAPER_TRADE_REARM_MINUTES=20

INTRADAY_MIN_RADAR_MOVE_PERCENT=0.30
INTRADAY_MIN_RELATIVE_VOLUME=1.40
INTRADAY_MIN_RECENT_MOVE_15M=0.45
INTRADAY_MIN_VOLUME_ACCELERATION=1.30
INTRADAY_MIN_EARLY_SCORE=80
INTRADAY_MIN_CONFIRMED_SCORE=75
INTRADAY_MIN_FRESH_BREAKOUT_SCORE=72
INTRADAY_MIN_CONTINUATION_SCORE=70
INTRADAY_MIN_CLEAN_TREND_SCORE=72
INTRADAY_MIN_MOVEMENT_CAPTURE_SCORE=65
INTRADAY_MAX_CHASE_RISK_SCORE=45

INTRADAY_MAX_VWAP_EXTENSION_PERCENT=2.50
INTRADAY_MAX_EXTENSION_ATR=2.50
INTRADAY_MIN_STOP_PERCENT=0.25
INTRADAY_MAX_STOP_PERCENT=2.00

# Per-trade option capital risk (NOT a percentage of account capital)
APLUS_SAFETY_TRADE_RISK_PERCENT=10.0
APLUS_OPTION_STOP_LOSS_PERCENT=10.0
